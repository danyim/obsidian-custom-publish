{
  "name": "custom-publish",
  "version": "1.0.0",
  "description": "Command palette actions to manage frontmatter publish and visibility properties, with a copy-URL command for published pages.",
  "main": "main.js",
  "scripts": {
    "dev": "node config/esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node config/esbuild.config.mjs production",
    "check-types": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prettier": "prettier --ignore-path config/.prettierignore --write \"./src/**/*.ts\" \"./test/**/*.ts\"",
    "clean": "npm run prettier && npm run lint:fix",
    "pretest": "npm run build",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "mocha --import=tsx \"test/unit/**/*.test.ts\"",
    "pretest:e2e": "npm run build",
    "test:e2e": "scripts/xvfb-wm.sh wdio run ./config/wdio.conf.mts",
    "version": "node scripts/version-bump.mjs && git add manifest.json versions.json",
    "postversion": "git push && git push --tags"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "publish",
    "frontmatter"
  ],
  "author": "danyim",
  "license": "MIT",
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.19.1",
    "@wdio/cli": "^9.32.0",
    "@wdio/globals": "^9.31.3",
    "@wdio/local-runner": "^9.32.0",
    "@wdio/mocha-framework": "^9.32.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "globals": "^17.13.0",
    "jiti": "^2.7.0",
    "mocha": "^11.8.0",
    "obsidian": "^1.13.1",
    "prettier": "^3.9.9",
    "tslib": "^2.8.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "wdio-obsidian-reporter": "^3.2.1",
    "wdio-obsidian-service": "^3.2.1"
  },
  "prettier": {
    "arrowParens": "always",
    "bracketSpacing": true,
    "endOfLine": "lf",
    "htmlWhitespaceSensitivity": "css",
    "bracketSameLine": false,
    "printWidth": 80,
    "proseWrap": "preserve",
    "quoteProps": "as-needed",
    "semi": true,
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false,
    "importOrder": [
      "^[./]"
    ],
    "importOrderSeparation": true,
    "importOrderSortSpecifiers": true,
    "plugins": [
      "@trivago/prettier-plugin-sort-imports"
    ]
  },
  "overrides": {
    "@puppeteer/browsers": "^3.2.3",
    "@wdio/mocha-framework": {
      "mocha": "$mocha"
    },
    "moment": "^2.31.0",
    "serialize-javascript": "^7.1.2",
    "diff": "^8.0.3"
  }
}
